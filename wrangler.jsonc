{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "appzed-doc-pipe",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "ai": {
    "binding": "AI"
  },
  "r2_buckets": [
    {
      "binding": "DOCS",
      "bucket_name": "appzed-doc-pipe-docs"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "appzed-doc-pipe-meta"
    }
  ]
}
